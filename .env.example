# Environment Variables Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ===================================
# Database Configuration
# ===================================

# H2 Database (Development)
SPRING_DATASOURCE_URL=jdbc:h2:mem:airqualitydb
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# MySQL Database (Production)
# Uncomment and configure for production use
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/air_quality_db
# SPRING_DATASOURCE_USERNAME=airquality
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ===================================
# Weather API Configuration
# ===================================

# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
WEATHER_API_KEY=da40a01545734ca7e86b2574509f30f1

# Weather API Base URL
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather

# ===================================
# Application Configuration
# ===================================

# Server Port
SERVER_PORT=8080

# Application Name
SPRING_APPLICATION_NAME=Air Quality Monitoring System

# ===================================
# JPA/Hibernate Configuration
# ===================================

# DDL Auto (create, create-drop, update, validate, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop

# Show SQL Queries (true for development, false for production)
SPRING_JPA_SHOW_SQL=true

# SQL Init Mode (never, always, embedded)
SPRING_SQL_INIT_MODE=never

# Hibernate Dialect
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect

# ===================================
# H2 Console Configuration
# ===================================

# Enable H2 Console (true for development, false for production)
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console

# ===================================
# Air Quality Configuration
# ===================================

# Enable Simulation
AIRQUALITY_SIMULATION_ENABLED=true

# Simulation Interval (milliseconds)
AIRQUALITY_SIMULATION_INTERVAL=30000

# Maximum Records to Keep
AIRQUALITY_SIMULATION_MAX_RECORDS=100

# Enable Alert Checking
AIRQUALITY_ALERT_ENABLED=true

# Alert Check Interval (milliseconds)
AIRQUALITY_ALERT_CHECK_INTERVAL=30000

# ===================================
# CORS Configuration
# ===================================

# Allowed Origins (comma-separated)
AIRQUALITY_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:80

# Allowed Methods
AIRQUALITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed Headers
AIRQUALITY_CORS_ALLOWED_HEADERS=*

# Allow Credentials
AIRQUALITY_CORS_ALLOW_CREDENTIALS=true

# ===================================
# Email Configuration (Optional)
# ===================================

# SMTP Server Configuration
# Uncomment and configure for email alerts
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your_app_specific_password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ===================================
# Logging Configuration
# ===================================

# Root Logging Level (ERROR, WARN, INFO, DEBUG, TRACE)
LOGGING_LEVEL_ROOT=INFO

# Application Logging Level
LOGGING_LEVEL_COM_AIRQUALITY=DEBUG

# Log File Path
# LOGGING_FILE_NAME=logs/air-quality.log

# ===================================
# Actuator Configuration
# ===================================

# Exposed Endpoints (comma-separated)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Show Health Details (always, never, when-authorized)
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ===================================
# Security Configuration (Future)
# ===================================

# JWT Secret Key (for future authentication)
# JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits

# JWT Expiration (milliseconds)
# JWT_EXPIRATION=86400000

# ===================================
# Docker Configuration
# ===================================

# Java Options for Docker
JAVA_OPTS=-Xmx512m -Xms256m

# ===================================
# Production Settings
# ===================================

# For Production, override these:
# - Set SPRING_JPA_SHOW_SQL=false
# - Set SPRING_H2_CONSOLE_ENABLED=false  
# - Set LOGGING_LEVEL_ROOT=WARN
# - Set AIRQUALITY_SIMULATION_ENABLED=false
# - Use MySQL instead of H2
# - Configure proper CORS origins
# - Enable Spring Security
# - Set up email service
# - Configure monitoring and alerting
